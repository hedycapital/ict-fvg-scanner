# ══════════════════════════════════════════════════════════════════
# ICT FVG 缺口扫描系统（Hyperliquid HIP-3 版）— 环境变量配置
# 复制本文件为 .env 并填写（GitHub Actions 环境下改用 Secrets/Vars）
# ══════════════════════════════════════════════════════════════════

# ── Telegram 推送（必填，生产模式）─────────────────────────────────
# @BotFather 创建 Bot 后获得的 Token（格式 123456:ABC-xxx）
TELEGRAM_BOT_TOKEN=
# 目标 Chat ID（把消息发给 @userinfobot 可查询自己的 ID；频道用 -100 开头 ID）
TELEGRAM_CHAT_ID=

# ── 扫描标的 ───────────────────────────────────────────────────────
# 可选白名单，逗号分隔，可省略 dex 前缀。设置后跳过全宇宙拉取（调试/聚焦用；
# 不受流动性门槛与 Top N 限制）
# 例：xyz:TSLA,xyz:GOLD 或 TSLA,GOLD,EUR
SYMBOLS=
# 流动性硬门槛：24h 名义成交额下限（USDC），低于者剔除（低流动性易出噪声缺口）
# 0 = 不过滤（全市场约 122 个）；示例：10000000 只扫成交额头部标的
MIN_VOLUME_USDC=0
# 白名单为空时：按 24h 成交额降序取前 N 个；0 = 不过滤
TOP_N=0

# ── 运行模式 ───────────────────────────────────────────────────────
# 1/true = 只扫描打印，不推送、不落盘（本地调试用）
DRY_RUN=

# ── 进阶（一般无需修改）───────────────────────────────────────────
# state 文件路径（默认 ./state.json）
STATE_PATH=state.json
# 冷启动拉取 K 线根数（默认 1500 ≈ 62.5 天的 1h K 线）
KLINE_LIMIT_COLD=1500
# Hyperliquid API 地址（默认官方域名；HL 不按地区封锁，一般无需反代）
HL_API_URL=
# HIP-3 dex 名（默认 xyz = Trade[XYZ]：美股代币/大宗商品/外汇）
HIP3_DEX=

# ── 网络代理（仅大陆本地调试需要；Actions 海外 runner 留空）────────
# 例：http://127.0.0.1:7897（Requests 原生识别 HTTPS_PROXY）
HTTPS_PROXY=
